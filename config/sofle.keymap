            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

        td_snake: td_snake {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DE_UNDERSCORE>, <&macro_exit_and_space>;
