            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

        th_camel: th_camel {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_CAMEL_EXIT";
            bindings = <&macro_exit_and_space>, <&sticky_shift>;

