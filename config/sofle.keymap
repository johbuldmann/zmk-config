            ignore-modifiers;
            lazy;
        };

        mod_thorn_key: mod_thorn_key {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_THORN_KEY";
            bindings = <&macro_sch>, <&macro_ch>;

