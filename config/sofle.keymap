#include <behaviors/anti_idle_mode.dtsi>
#include <dt-bindings/anti_idle_mode.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#ifndef KEYMAP_DRAWER

#include "keys_de.h"

#endif

#define DEF 0
#define QWER 1
#define GAME 2
#define NAV 3
#define SYMB 4
#define ADJ 5
#define OLD 6

// #include <behaviors/mouse.dtsi>
/* Global settings */

#define QUICK_TAP_MS 175

&caps_word { continue-list = <DE_UNDERSCORE DE_MINUS DE_SLASH DE_QUESTION BACKSPACE DELETE LSHIFT>; };

&sl { ignore-modifiers; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        combo_F24_minimize_Window {
            bindings = <&kp LC(F24)>;
            key-positions = <0 1>;
            layers = <0 1 2 4 5 8 12 9 11 7 6 14>;
            timeout-ms = <50>;
            require-prior-idle-ms = <90>;
        };

        combo_CTRL_Z {
            bindings = <&kp LC(DE_Z)>;
            key-positions = <>;
            layers = <0 1 2 4 5 8 12 9>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_copy_cut {
            bindings = <&mt LC(X) LC(C)>;
            key-positions = <>;
            layers = <0 1 2 4 5 8 12 9>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_CTRL_V {
            bindings = <&kp LC(V)>;
            key-positions = <>;
            layers = <0 1 2 4 5 8 12 9>;
            timeout-ms = <22>;
            require-prior-idle-ms = <100>;
        };

        combo_win_paste {
            bindings = <&mod_taptap_150 LS(LC(V)) LG(V)>;
            key-positions = <>;
            layers = <0 1 2 4 5 8 9>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_CTRL_Y {
            bindings = <&kp LC(DE_Y)>;
            key-positions = <>;
            layers = <0 1 2 4 5 8 12 9>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_CTRL_Backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <19 20>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_CTRL_Delete {
            bindings = <&kp LC(DELETE)>;
            key-positions = <20 21>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        combo_Printscreen1 {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <10 11>;
            layers = <0 1 2 4 5 8 12 9>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_Guillemets_open {
            bindings = <&macro_Guillemets_open>;
            key-positions = <1 2>;
            layers = <0 1 2 4 5 8>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
        };

        combo_Guillemets_close {
            bindings = <&macro_Guillemets_close>;
            key-positions = <2 3>;
            layers = <0 1 2 4 5 8>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
        };

        combo_capsword {
            bindings = <&caps_word>;
            key-positions = <25 34>;
            layers = <0 1 2 4 5 8>;
            timeout-ms = <65>;
            require-prior-idle-ms = <150>;
        };

        combo_en_dash2 {
            bindings = <&macro_en_dash>;
            key-positions = <48 47>;
            layers = <0 1 2 4 5 8 6 14 11>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_question {
            bindings = <&kp DE_QUESTION>;
            key-positions = <46 47>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14>;
            timeout-ms = <50>;
            require-prior-idle-ms = <75>;
        };

        combo_exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <46 45>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14>;
            timeout-ms = <45>;
            require-prior-idle-ms = <100>;
        };

        combo_Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <31 32>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14 3 7 13>;
            timeout-ms = <30>;
            require-prior-idle-ms = <70>;
        };

        combo_listary_new {
            bindings = <&kp F22>;
            key-positions = <28 29>;
            layers = <0 1 2 4 5 8>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        combo_new_window {
            bindings = <&kp LC(N)>;
            key-positions = <16 17>;
            timeout-ms = <35>;
            require-prior-idle-ms = <300>;
            layers = <0 1 2 4 5 8>;
        };

        combo_em_dash2 {
            bindings = <&macro_em_dash>;
            key-positions = <47 48 46>;
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 4 5 8 6 14>;
        };

        combo_new_tab {
            bindings = <&kp LC(T)>;
            key-positions = <16 15>;
            timeout-ms = <30>;
            require-prior-idle-ms = <300>;
            layers = <0 1 2 4 5 8>;
        };

        combo_Delete {
            bindings = <&kp DELETE>;
            key-positions = <32 33>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14>;
        };

        combo_arrowa_right {
            bindings = <&macro_arrow_right>;
            key-positions = <48 49>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 4 5 8>;
        };

        combo_Paste_withouta_formatting {
            bindings = <&kp LC(LS(V))>;
            key-positions = <>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 4 5 8>;
        };

        combo_change_audiodevice {
            bindings = <&kp LA(LS(LC(F14)))>;
            key-positions = <5 6>;
            timeout-ms = <40>;
            layers = <0 1 2 4 5>;
        };

        combo_Printscreen2 {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <4 5>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 4 5 8>;
        };

        combo_CTRL_Z_2 {
            bindings = <&kp LC(DE_Z)>;
            key-positions = <18 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 4 5 8 9 11 10 12 6>;
        };

        combo_Menuekey {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <50 51>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
            layers = <0 1 2 4 5 8>;
        };

        combo_p {
            bindings = <&macro_p>;
            key-positions = <41 40>;
            layers = <13>;
        };

        combo_escape {
            bindings = <&kp ESCAPE>;
            key-positions = <27 32>;
            timeout-ms = <55>;
            require-prior-idle-ms = <120>;
            layers = <0 1 2 4 5 8 6 11 10 12 3 7 14>;
        };

        combo_snake_case {
            bindings = <&camel_case 3>;
            key-positions = <>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <0 1 2 4 5 8>;
        };

        combo_F24_minimize_Window_2 {
            bindings = <&kp LC(F24)>;
            key-positions = <15 14>;
            timeout-ms = <22>;
            require-prior-idle-ms = <150>;
            layers = <2 4 5 8 0 12 9 11>;
        };

        combo_number_layer_left {
            bindings = <&tog 7>;
            key-positions = <38 39>;
            layers = <0 1 2>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };

        combo_exit_left_numberlayer {
            bindings = <&tog 7>;
            key-positions = <38 39>;
            layers = <7>;
        };

        combo_escape2 {
            bindings = <&kp ESCAPE>;
            key-positions = <26 27>;
            timeout-ms = <30>;
            require-prior-idle-ms = <70>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14 3 7 13>;
        };

        combo_Shift_Enter {
            bindings = <&mod_taptap_150 LC(ENTER) LS(ENTER)>;
            key-positions = <31 30>;
            timeout-ms = <30>;
            require-prior-idle-ms = <70>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14 3 7 13>;
        };

        combo_raycast {
            bindings = <&kp LA(SPACE)>;
            key-positions = <28 27>;
            timeout-ms = <30>;
            require-prior-idle-ms = <70>;
            layers = <0 1 2 4 5 8 9 11 10 6 14 3 7 13>;
        };

        combo_f24_universal_key_2 {
            bindings = <&mod_taptap_150 LS(F24) F24>;
            key-positions = <28 31>;
            timeout-ms = <30>;
            require-prior-idle-ms = <70>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14 3 7 13>;
        };

        combo_+f24_universal_key_3 {
            bindings = <&kp LS(F24)>;
            key-positions = <28 30>;
            timeout-ms = <30>;
            require-prior-idle-ms = <70>;
            layers = <0 1 2 4 5 8 9 11 10 12 6 14 3 7 13>;
        };
    };

    macros {
        macro_Guillemets_open: macro_Guillemets_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MACRO_GUILLEMETS_OPEN";
            wait-ms = <7>;
            tap-ms = <10>;
        };

        macro_Guillemets_close: macro_Guillemets_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_NUMBER_7 &kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MACRO_GUILLEMETS_CLOSE";
            wait-ms = <7>;
            tap-ms = <10>;
        };

        // 1: Deutsch Anführungszeichen unten „ (Alt+0132)

        macro_de_quote_open: macro_de_quote_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N3 &kp KP_N2>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 2: Deutsch Anführungszeichen oben “ (Alt+0147)

        macro_de_quote_close: macro_de_quote_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N4 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 3: Französische Guillemets open « (Alt+0171)

        macro_fr_guillemet_open: macro_fr_guillemet_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N1>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 4: Französische Guillemets close » (Alt+0187)

        macro_fr_guillemet_close: macro_fr_guillemet_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 5: Bullet Point • (Alt+0149)

        macro_bullet: macro_bullet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N4 &kp KP_N9>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 6: Ellipse … (Alt+0133)

        macro_ellipsis: macro_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 7: Plus-Minus ± (Alt+0177)

        macro_plusminus: macro_plusminus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        // 8: Ungefähr ≈ (Alt+247)

        macro_approx: macro_approx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N2 &kp KP_N4 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        // ’ Typografischer Apostroph (Alt+0146)

        macro_apostrophe: macro_apostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N4 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        // × Echtes Mal-Zeichen (Alt+0215)

        macro_mult: macro_mult {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N5>,
                <&macro_release>,
                <&kp LALT>;
        };

        // ÷ Geteilt-Zeichen (Alt+0247)

        macro_div: macro_div {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        // NBSP: Geschütztes Leerzeichen (Alt+0160)

        macro_nbsp: macro_nbsp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N0>,
                <&macro_release>,
                <&kp LALT>;
        };

        // NNBSP: Schmales geschütztes Leerzeichen (Alt+8239)
        // Hinweis: Windows unterstützt vierstellige Alt-Codes über 255 oft nur 
        // mit dem "EnableHexNumpad" Registry-Key. Dies ist der "Best Effort" Code:

        macro_nnbsp: macro_nnbsp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N8 &kp KP_N2 &kp KP_N3 &kp KP_N9>,
                <&macro_release>,
                <&kp LALT>;
        };

        macro_select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT_ARROW &kp LS(RIGHT_ARROW)>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "SELECT_WORD";
            wait-ms = <7>;
            tap-ms = <10>;
        };

        macro_en_dash: macro_en_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_5 &kp KP_NUMBER_0>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MACRO_EN_DASH";
        };

        macro_em_dash: macro_em_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_5 &kp KP_NUMBER_1>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MACRO_EM_DASH";
        };

        macro_arrow_right: macro_arrow_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_2 &kp KP_NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MACRO_ARROW_RIGHT";
        };

        macro_single_backtick_grave: macro_single_backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(EQUAL) &kp SPACE>;

            label = "MACRO_SINGLE_BACKTICK";
        };

        macro_triple_backtick: macro_tripple_backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LS(EQUAL) &kp SPACE &kp LS(EQUAL) &kp SPACE &kp LS(EQUAL) &kp SPACE>;

            label = "MACRO_TRIPPLE_BACKTICK";
            wait-ms = <6>;
            tap-ms = <9>;
        };

        macro_zirkumflex: macro_zirkumflex {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp GRAVE &kp SPACE>;

            label = "MACRO_ZIRKUMFLEX";
        };

        macro_p: macro_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <6>;
            tap-ms = <8>;
            bindings = <&kp LS(L) &kp A &kp L &kp E &kp F &kp A &kp R &kp N &kp DE_PLUS &kp S &kp D &kp F &kp S &kp D &kp F>;
            label = "MACRO_P";
        };

        macro_ch: macro_thorn_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings = <&kp C &kp H>;
            label = "MACRO_THORN_KEY";
        };

        macro_sch: macro_thorn_key_held {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings = <&kp S &kp C &kp H>;
            label = "MACRO_THORN_KEY_HELD";
        };

        macro_and: macro_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp D>;
            label = "MACRO_AND";
            wait-ms = <5>;
            tap-ms = <8>;
        };

        macro_you: macro_you {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_Y &kp O &kp U>;
            label = "MACRO_YOU";
            wait-ms = <5>;
            tap-ms = <8>;
        };

        macro_email: macro_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp J &kp O &kp H &kp A &kp N &kp N &kp E &kp S &kp DE_AT &kp B &kp U &kp L &kp D &kp M &kp A &kp N &kp N &kp DOT &kp D &kp E>;
            label = "MACRO_EMAIL";
            wait-ms = <5>;
            tap-ms = <8>;
        };

        macro_th: macro_th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings = <&kp T &kp H>;
            label = "MACRO_TH";
        };

        macro_qu: macro_qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings = <&kp Q &kp U>;
            label = "MACRO_QU";
        };

        macro_exit_and_space: macro_exit_and_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <8>;
            bindings = <&kp SPACE>;
            label = "MACRO_EXIT_N_SPACE";
        };

        macro_pascal_start: macro_pascal_start {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sticky_shift LSHIFT &camel_case 4>;
        };

        macro_Qu_capitalized: macro_Qu_capitalized {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <10>;
            bindings = <&kp LS(Q) &kp U>;
            label = "MACRO_QU_CAPITALIZED";
        };

        macro_unstick_mods: macro_unstick_mods {
            label = "MACRO_UNSTICK_MODS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <16>;
            tap-ms = <20>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };

        anti_idle {
            compatible = "zmk,anti-idle-generic";
            interval-ms = <15000>;                      // Alle 60 Sekunden aktiv werden
            bindings = <&mmv MOVE_DOWN &mmv MOVE_UP>;   // Schiebt die Maus kurz runter und hoch
            tap_ms = <100>;                              // Sehr kurze Bewegung, damit es nicht nervt
            wait_ms = <200>;                             // Pause zwischen Runter und Hoch
        };
    };

    behaviors {
        hrm_shift_l: hrm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_SHIFT_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            flavor = "balanced";
