&mod_taptap_150 DE_DEGREE DE_CARET  &macro_de_quote_open                            &macro_de_quote_close             &macro_fr_guillemet_open              &macro_fr_guillemet_close  &macro_bullet                                    &macro_plusminus   &macro_mult              &macro_div                &macro_ellipsis   &macro_nbsp           &macro_nnbsp
&kp TAB                             &macro_single_backtick_grave                    &mod_tapBackticTrippe 0 DE_MINUS  &mod_taptap_150 DE_EURO DE_LESS_THAN  &kp DE_GREATER_THAN        &kp PERCENT                                      &macro_zirkumflex  &kp DE_LEFT_BRACE        &kp DE_RIGHT_BRACE        &kp DE_COLON      &kp DE_DOLLAR         &mt DE_GRAVE DE_ACUTE
&kp LSHFT                           &mod_taptap_150 DE_EXCLAMATION DE_SINGLE_QUOTE  &kp DE_ASTERISK                   &kp DE_SLASH                          &kp DE_EQUAL               &kp DE_AMPERSAND                                 &kp DE_POUND       &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_SEMICOLON  &kp DE_DOUBLE_QUOTES  &kp DE_BACKSLASH
&kp LEFT_CONTROL                    &kp DE_TILDE                                    &kp DE_PLUS                       &kp DE_LEFT_BRACKET                   &kp DE_RIGHT_BRACKET       &kp DE_PIPE                    &trans    &trans  &kp RA(DE_Q)       &kp DE_UNDERSCORE        &kp COMMA                 &kp DE_PERIOD     &kp DE_UNDERSCORE     &macro_arrow_right
                                                                                    &trans                            &trans                                &trans                     &hrm_momentary_layer 14 SPACE  &trans    &trans  &trans             &trans                   &trans                    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Numpad_Layer {
            display-name = "numpad";
            bindings = <
&kp ESCAPE        &none                        &none                        &none                        &none                        &none                              &kp KP_NUMLOCK    &none            &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp DE_GRAVE                      &kp DE_ACUTE
&kp TAB           &kp LC(LS(F15))              &kp LS(LC(F16))              &kp LS(LC(F17))              &kp LS(LC(F18))              &kp LS(LC(F19))                    &kp DE_COLON      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS                      &kp DE_HASH
&kp LSHFT         &mod_taptap_150 LS(F15) F15  &mod_taptap_150 LS(F16) F16  &mod_taptap_150 LS(F17) F17  &mod_taptap_150 LS(F18) F18  &kp F19                            &kp DE_SEMICOLON  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &hrm_shift_r RIGHT_SHIFT KP_PLUS  &trans
&kp LEFT_CONTROL  &kp LC(F15)                  &kp LC(F16)                  &kp LC(F17)                  &kp LC(F18)                  &kp LC(F19)      &trans    &trans  &kp KP_NUMBER_0   &kp KP_N1        &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL                      &trans
                                               &trans                       &trans                       &trans                       &trans           &trans    &trans  &kp SPACE         &kp KP_N0        &kp COMMA        &kp PERIOD
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Navigation_Layer {
            display-name = "navigation";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp ESCAPE        &kp F1        &kp F2       &kp F3                                     &kp F4                                &kp F5                                                   &kp F6              &kp F7          &kp F8              &kp F9               &kp F10        &kp F11
&kp TAB           &kp LA(TAB)   &kp LG(TAB)  &mod_taptap_150 LG(LC(LEFT_ARROW)) LS(F1)  &mod_taptap_150 LC(LG(RIGHT)) LS(F2)  &kp LS(F4)                                               &kp HOME            &none           &macro_select_word  &kp END              &kp END        &kp F12
&kp LEFT_SHIFT    &kp LC(A)     &kp ESCAPE   &kp BACKSPACE                              &kp DEL                               &kp ENTER                                                &kp LEFT            &kp DOWN        &kp UP_ARROW        &kp RIGHT            &kp LS(ENTER)  &macro_unstick_mods
&kp LEFT_CONTROL  &kp LC(DE_Z)  &kp LC(X)    &kp LC(C)                                  &kp LC(V)                             &mod_taptap_150 LS(LC(V)) LG(V)  &trans       &trans     &kp LC(LEFT_ARROW)  &kp PAGE_DOWN   &kp PAGE_UP         &kp LC(RIGHT_ARROW)  &kp LEFT_GUI   &kp RIGHT_CONTROL
                                &trans       &trans                                     &trans                                &trans                           &kp ENTER    &kp ENTER  &kp SPACE           &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Adjust_Layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0     &bt BT_SEL 1         &bt BT_SEL 2         &bt BT_SEL 3         &bt BT_SEL 4                            &out OUT_USB  &out OUT_BLE  &bt BT_CLR    &bt BT_CLR_ALL  &none         &kp KP_NUMLOCK
&bt BT_CLR_ALL    &to 0            &to 1                &to 2                &to 9                &to 12                                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &kp LS(LA(LC(F12)))
&kp LA(CAPSLOCK)  &kp PRINTSCREEN  &kp LA(PRINTSCREEN)  &kp LS(PRINTSCREEN)  &kp LC(PRINTSCREEN)  &none                                   &kp LS(F14)   &kp LS(F14)   &kp F14       &kp LC(F15)     &none         &none
&bootloader       &sys_reset       &none                &aim AIM_ON          &aim AIM_OFF         &none             &trans        &trans  &none         &none         &none         &none           &sys_reset    &bootloader
                                   &none                &none                &kp C_PREV           &kp C_PLAY_PAUSE  &kp C_NEXT    &none   &none         &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        number_layer_duplicate {
            display-name = "number_duplicate";
            bindings = <
&kp ESCAPE        &none                                         &none                       &none                         &none                           &none                        &none                          &none                             &none                           &none                         &none                        &none
&kp TAB           &kp F1                                        &kp F2                      &kp F3                        &kp F4                          &kp F5                       &kp F6                         &kp F7                            &kp F8                          &kp F9                        &kp F10                      &kp F11
&kp LSHFT         &hrm_mods_left_short_tappingterm LEFT_GUI N1  &hrm_mods_left LEFT_ALT N2  &hrm_mods_left LEFT_SHIFT N3  &hrm_mods_left LEFT_CONTROL N4  &kp N5                       &kp N6                         &hrm_mods_right RIGHT_CONTROL N7  &hrm_mods_right RIGHT_SHIFT N8  &hrm_mods_right LALT N9       &hrm_mods_right LEFT_GUI N0  &kp F12
&kp LEFT_CONTROL  &kp DE_MINUS                                  &kp DE_PLUS                 &kp DE_ASTERISK               &kp DE_SLASH                    &kp N0  &trans    &trans     &none                          &mod_taptap_150 J SPACE           &mod_taptap_150 K COMMA         &mod_taptap_150 DE_COLON DOT  &kp DE_MINUS                 &kp DE_UNDERSCORE
                                                                &trans                      &trans                        &trans                          &trans  &trans    &kp ENTER  &hrm_momentary_layer 10 SPACE  &trans                            &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
